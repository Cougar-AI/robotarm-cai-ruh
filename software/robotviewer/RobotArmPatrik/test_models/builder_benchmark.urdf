<?xml version="1.0"?>
<robot name="builder_benchmark">
  <link name="world_link"/>
  <link name="base_mesh_link">
    <visual>
      <origin xyz="0.000124 0.000214 -0.010426" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/Base-1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.000124 0.000214 -0.010426" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/Base-1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="world_to_base_mesh" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world_link"/>
    <child link="base_mesh_link"/>
  </joint>
  <link name="motor_mesh_link">
    <visual>
      <origin xyz="0 -0.000141 -0.025847" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/Motor2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.000141 -0.025847" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/Motor2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="base_to_motor_mesh" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_mesh_link"/>
    <child link="motor_mesh_link"/>
  </joint>
</robot>
